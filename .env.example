PINECONE_API_KEY=PEGA_TU_CLAVE_DE_PINECONE
INDEX_NAME=rag-governance
MIN_SCORE=0.5
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:latest
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OLLAMA_NUM_CTX=8192
USE_EMBEDDED_DB=1
POSTGRES_DB=banco_sintetico
# Opcional: PostgreSQL externo (USE_EMBEDDED_DB=0) -> PGHOST, PGPORT, PGUSER, PGPASSWORD, APP_ROLE_PASSWORD
# Opcional: cambiar de LLM sin tocar código -> LLM_PROVIDER=google + LLM_MODEL=gemini-3.5-flash + GOOGLE_API_KEY=...
