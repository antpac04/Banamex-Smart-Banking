PINECONE_API_KEY=PEGA_TU_CLAVE_DE_PINECONE
INDEX_NAME=rag-governance
MIN_SCORE=0.5
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:latest
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OLLAMA_NUM_CTX=8192
# SQL_LIBRE: 0 = el modelo NO escribe SQL (lo pide la capa semántica del socio); 1 = solo desarrollo
SQL_LIBRE=0
# Segundos por pregunta antes de responder "no fue posible atender tu consulta"
TIEMPO_MAXIMO_RESPUESTA=150
RAG_TOP_K=4
USE_EMBEDDED_DB=1
POSTGRES_DB=banco_sintetico
# Opcional: PostgreSQL externo (USE_EMBEDDED_DB=0) -> PGHOST, PGPORT, PGUSER, PGPASSWORD, APP_ROLE_PASSWORD
# Opcional: cambiar de LLM sin tocar código -> LLM_PROVIDER=google + LLM_MODEL=gemini-3.5-flash + GOOGLE_API_KEY=...
# --- LangSmith (trazas y evaluaciones). Con LANGSMITH_TRACING=true cada pregunta de la app queda trazada.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=data-steward-banamex
# Modelo barato para el "juez" de las evaluaciones (solo con LLM_PROVIDER=google)
EVAL_MODELO_JUEZ=gemini-3.1-flash-lite